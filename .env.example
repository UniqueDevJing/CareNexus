# CareNexus production environment template
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_USER=carenexus
MYSQL_PASSWORD=replace-with-an-application-password
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=8
# Bundled demo nginx is HTTP; set true only when the public entrypoint is HTTPS.
AUTH_COOKIE_SECURE=false

# AI provider: auto | real | mock
LLM_MODE=real
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-dashscope-key
LLM_CHAT_MODEL=qwen-flash
LLM_EMBEDDING_MODEL=text-embedding-v3

# Optional frontend dev proxy target
V2_BACKEND=http://127.0.0.1:18092
