MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_USER=carenexus
MYSQL_PASSWORD=change-app-password
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# The bundled nginx entrypoint is HTTP. Set true only when a TLS reverse proxy is in front.
AUTH_COOKIE_SECURE=false
LLM_MODE=real
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-dashscope-key
LLM_CHAT_MODEL=qwen-flash
LLM_EMBEDDING_MODEL=text-embedding-v3
